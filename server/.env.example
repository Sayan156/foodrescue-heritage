NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foodrescue?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password recovery: verified sender address and API key from Resend.
PUBLIC_APP_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=
# Production only: actual trusted reverse-proxy hop count, e.g. 1.
TRUST_PROXY_HOPS=
